{
  "name": "resident",
  "version": "1.0.0",
  "description": "The resident-facing mobile app: sign in with phone OTP, see nearby vendors on an OpenStreetMap-tiled map, get push notified when one is approaching, set category preferences, and rate vendors after they've actually passed by (backend enforces this - see README).",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "axios": "^1.20.0",
    "expo": "^57.0.22",
    "expo-device": "~57.0.2",
    "expo-image": "~57.0.5",
    "expo-location": "~57.0.17",
    "expo-notifications": "~57.0.18",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  }
}
